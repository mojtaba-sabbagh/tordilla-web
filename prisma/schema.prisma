// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "debian-openssl-1.1.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model BlogPost {
  id            String    @id @default(cuid())
  slug          String    @unique
  title         Json      // { "fa": "عنوان فارسی", "en": "English title" }
  category      Json      // { "fa": "دسته بندی فارسی", "en": "English category" }
  categorySlug  String    // single slug for routing (same for both languages)
  date          DateTime  @default(now())
  image         String
  imageWidth    Int       @default(800)
  imageHeight   Int       @default(600)
  excerpt       Json      // { "fa": "خلاصه فارسی", "en": "English excerpt" }
  content       Json      // { "fa": "متن فارسی", "en": "English content" }
  author        Json      // { "fa": "نویسنده فارسی", "en": "Author name" }
  published     Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  comments      Comment[]
}

model Comment {
  id            String    @id @default(cuid())
  name          String
  email         String
  content       String    @db.Text
  status        CommentStatus @default(PENDING)
  blogPostId    String
  blogPost      BlogPost  @relation(fields: [blogPostId], references: [id], onDelete: Cascade)
  createdAt     DateTime  @default(now())
  
  @@index([blogPostId])
  @@index([status])
  @@index([createdAt])
}

enum CommentStatus {
  PENDING
  APPROVED
  REJECTED
}

model SitePageContent {
  id            String    @id @default(cuid())
  pageKey       String
  language      String
  title         String
  content       Json
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([pageKey, language])
  @@index([pageKey])
  @@index([language])
}

model Admin {
  id            String    @id @default(cuid())
  username      String    @unique
  password      String    // hashed
  createdAt     DateTime  @default(now())
}

model ContactMessage {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  phone     String?
  subject   String
  message   String   @db.Text
  status    String   @default("UNSEEN")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
}

enum Status {
  UNSEEN
  SEEN
  REPLIED
  ARCHIVED
}
/// One row per page view recorded by the client-side beacon (`/api/track`).
/// Location is snapshotted onto the row so historical stats stay stable even
/// if the IP is later reassigned to somewhere else.
model PageView {
  id           String   @id @default(cuid())
  path         String
  query        String?
  title        String?
  locale       String?
  referrer     String?
  referrerHost String?
  userAgent    String?  @db.Text
  ip           String
  visitorId    String   // sha256(ip + user agent + salt) — stable pseudonymous id
  sessionId    String?  // per browser-tab session, used to count visits
  deviceType   String?  // mobile | tablet | desktop
  browser      String?
  os           String?
  isBot        Boolean  @default(false)
  country      String?
  countryCode  String?
  region       String?
  city         String?
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@index([isBot, createdAt])
  @@index([path])
  @@index([ip])
  @@index([visitorId])
  @@index([country])
}

/// Cache for IP → location lookups so the same visitor is only resolved once.
model IpLocation {
  ip          String   @id
  country     String?
  countryCode String?
  region      String?
  city        String?
  latitude    Float?
  longitude   Float?
  isp         String?
  status      String   @default("OK") // OK | FAILED | PRIVATE
  lookedUpAt  DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
}
